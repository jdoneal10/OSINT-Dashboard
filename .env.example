# Copy to .env for local overrides. Never commit .env.
# Secrets (API keys) belong in macOS Keychain:
#   uv run --project backend python -m app.core.secrets set <NAME>
# Environment variables below are the fallback when Keychain has no entry.

# Database (defaults match docker-compose.yml)
OSINT_DATABASE_URL=postgresql+psycopg://osint:osint@127.0.0.1:5432/osint
OSINT_TEST_DATABASE_URL=postgresql+psycopg://osint:osint@127.0.0.1:5432/osint_test

# Environment: dev | test | ci
OSINT_ENV=dev

# Monthly LLM budget cap in USD (Phase 2+)
OSINT_LLM_MONTHLY_BUDGET_USD=75

# Secret fallbacks (leave blank; prefer Keychain)
ANTHROPIC_API_KEY=
ACLED_USERNAME=
ACLED_PASSWORD=
