# --- Data handling (CLAUDE.md hard rules 5) ---
# Raw source snapshots never enter git.
data/raw/
# Local basemap extract and vendored glyphs/sprites (large, regenerable).
data/basemap/
# Any ACLED-derived export, anywhere in the tree.
*acled*export*
*acled*.csv
*acled*.parquet
*acled*.xlsx

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# --- OS / editors ---
.DS_Store
.idea/
.vscode/
*.swp
